# Sentinel frontend vhost for nginx (static dist + same-origin API proxy).
# Install at /etc/nginx/sites-available/sentinel-frontend and enable with
#   sudo ln -s /etc/nginx/sites-available/sentinel-frontend /etc/nginx/sites-enabled/
# Then run: sudo certbot --nginx -d sentinel-org.absg-ohos.cloud
#
# Do not enable this block before certbot has issued the certificate; the TLS
# paths below are created by certbot.

server {
    listen 80;
    listen [::]:80;
    server_name sentinel-org.absg-ohos.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sentinel-org.absg-ohos.cloud;

    root /var/www/sentinel-frontend/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/sentinel-org.absg-ohos.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sentinel-org.absg-ohos.cloud/privkey.pem;

    # Same-origin API proxy. The incoming /api/v1 path is forwarded unchanged.
    location /api/v1/ {
        proxy_pass https://sentinel-api.absg-ohos.cloud;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host sentinel-api.absg-ohos.cloud;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /api/v1 {
        proxy_pass https://sentinel-api.absg-ohos.cloud;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host sentinel-api.absg-ohos.cloud;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.(?:css|js|woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
