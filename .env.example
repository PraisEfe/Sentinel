# Browser API requests default to same-origin /api/v1 in every mode.
# Vite (dev/preview) and npm start (production) proxy it to this backend:
API_PROXY_TARGET=https://sentinel-api.absg-ohos.cloud

# For a local backend instead:
# API_PROXY_TARGET=http://127.0.0.1:8000

# Optional direct browser access. Only use if the backend explicitly allows
# the deployed frontend origin through CORS. This is a build-time setting.
# VITE_API_BASE_URL=https://sentinel-api.absg-ohos.cloud/api/v1

# npm start uses PORT=3000 and HOST=0.0.0.0 unless overridden.
# PORT=3000
# HOST=0.0.0.0

# VITE_ values are public. Never put credentials into VITE_ variables.
