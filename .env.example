# Optional override. Development defaults to Vite's same-origin /api/v1 proxy.
# Production defaults to the API documented in docs/openapi.json.
# VITE_API_BASE_URL=https://sentinel-api.absg-ohos.cloud/api/v1

# To use a local backend in development, change only the proxy destination:
# API_PROXY_TARGET=http://127.0.0.1:8000

# VITE_ values are public build-time settings. Never put secrets here.
